ARG CUDA_VERSION=13.3.0
ARG UBUNTU_VERSION=24.04

FROM docker.io/nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libgomp1 \
    libstdc++6 \
    libcurl4 \
    libavcodec60 \
    libavformat60 \
    libavutil58 \
    libswscale7 \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# 清理 GeForce 显卡不兼容的前向兼容库，避免 cudaErrorCompatNotSupportedOnDevice
RUN rm -rf /usr/local/cuda-13.3/compat /usr/local/cuda-13/compat /usr/local/cuda/compat

# 单个 multicall 可执行文件，按 argv[0] 分发；两个名字用符号链接
COPY dist/bin/ninfer-multicall /usr/local/bin/ninfer-multicall
RUN ln -s ninfer-multicall /usr/local/bin/ninfer-serve && ln -s ninfer-multicall /usr/local/bin/ninfer

RUN mkdir -p /models && chmod 777 /models
WORKDIR /models
EXPOSE 18200

ENTRYPOINT ["ninfer-serve"]
CMD ["--help"]
